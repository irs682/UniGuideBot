# ==========================================
# FYP BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ingestionDB
# Example Atlas URI:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ingestionDB?retryWrites=true&w=majority

# Secret for signing JWT authentication tokens
JWT_SECRET=supersecretjwtkey_change_in_production

# URL of the running Python FastAPI Chatbot service
FASTAPI_URL=http://localhost:8000

# Frontend URL for generating password reset email links
FRONTEND_URL=http://localhost:3000

# Optional: Custom Python executable path (e.g. /var/www/fyp-chatbot/UniversityChatbotFinal/venv/bin/python)
PYTHON_PATH=

# Email configuration for nodemailer (password reset & scraper notifications)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
